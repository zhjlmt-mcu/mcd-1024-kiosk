         { .uri = "/preview", .method = HTTP_POST, .handler = handler_preview, .user_ctx = NULL },
+        { .uri = "/kiosk",                 .method = HTTP_GET, .handler = handler_kiosk, .user_ctx = NULL },
+        { .uri = "/kiosk/",                .method = HTTP_GET, .handler = handler_kiosk, .user_ctx = NULL },
+        { .uri = "/kiosk/css/style.css",   .method = HTTP_GET, .handler = handler_kiosk, .user_ctx = NULL },
+        { .uri = "/kiosk/js/menu-data.js", .method = HTTP_GET, .handler = handler_kiosk, .user_ctx = NULL },
+        { .uri = "/kiosk/js/ai.js",        .method = HTTP_GET, .handler = handler_kiosk, .user_ctx = NULL },
+        { .uri = "/kiosk/js/voice.js",     .method = HTTP_GET, .handler = handler_kiosk, .user_ctx = NULL },
+        { .uri = "/kiosk/js/app.js",       .method = HTTP_GET, .handler = handler_kiosk, .user_ctx = NULL },
     };
     for (unsigned i = 0; i < sizeof(uris) / sizeof(uris[0]); i++) {
