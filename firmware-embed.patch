diff --git a/s31-image-viewer/main/http_xfer.c b/s31-image-viewer/main/http_xfer.c
index 8fd380c..bc5b1c4 100644
--- a/s31-image-viewer/main/http_xfer.c
+++ b/s31-image-viewer/main/http_xfer.c
@@ -37,6 +37,59 @@ static httpd_handle_t s_server;
 extern const uint8_t web_page_start[] asm("_binary_ble_upload_html_start");
 extern const uint8_t web_page_end[]   asm("_binary_ble_upload_html_end");
 
+/* 1024-kiosk 点餐屏：构建时直接嵌入仓库 1024-kiosk/ 源文件（单一来源，
+ * 改页面后重编译即生效），伺服在 /kiosk 下 */
+extern const uint8_t kiosk_index_start[]     asm("_binary_index_html_start");
+extern const uint8_t kiosk_index_end[]       asm("_binary_index_html_end");
+extern const uint8_t kiosk_css_start[]       asm("_binary_style_css_start");
+extern const uint8_t kiosk_css_end[]         asm("_binary_style_css_end");
+extern const uint8_t kiosk_menudata_start[]  asm("_binary_menu_data_js_start");
+extern const uint8_t kiosk_menudata_end[]    asm("_binary_menu_data_js_end");
+extern const uint8_t kiosk_ai_start[]        asm("_binary_ai_js_start");
+extern const uint8_t kiosk_ai_end[]          asm("_binary_ai_js_end");
+extern const uint8_t kiosk_voice_start[]     asm("_binary_voice_js_start");
+extern const uint8_t kiosk_voice_end[]       asm("_binary_voice_js_end");
+extern const uint8_t kiosk_app_start[]       asm("_binary_app_js_start");
+extern const uint8_t kiosk_app_end[]         asm("_binary_app_js_end");
+
+typedef struct {
+    const char *uri;
+    const char *type;
+    const uint8_t *start;
+    const uint8_t *end;
+} kiosk_asset_t;
+
+static const kiosk_asset_t s_kiosk_assets[] = {
+    { "/kiosk",                 "text/html; charset=utf-8", kiosk_index_start, kiosk_index_end },
+    { "/kiosk/",                "text/html; charset=utf-8", kiosk_index_start, kiosk_index_end },
+    { "/kiosk/css/style.css",   "text/css",                 kiosk_css_start,   kiosk_css_end },
+    { "/kiosk/js/menu-data.js", "application/javascript",   kiosk_menudata_start, kiosk_menudata_end },
+    { "/kiosk/js/ai.js",        "application/javascript",   kiosk_ai_start,    kiosk_ai_end },
+    { "/kiosk/js/voice.js",     "application/javascript",   kiosk_voice_start, kiosk_voice_end },
+    { "/kiosk/js/app.js",       "application/javascript",   kiosk_app_start,   kiosk_app_end },
+};
+
+static esp_err_t handler_kiosk(httpd_req_t *req)
+{
+    /* 页面资源是相对路径，必须以 /kiosk/ 结尾为基准解析；无斜杠一律 302 */
+    if (strcmp(req->uri, "/kiosk") == 0) {
+        httpd_resp_set_hdr(req, "Location", "/kiosk/");
+        httpd_resp_set_status(req, "302 Found");
+        httpd_resp_sendstr(req, "");
+        return ESP_OK;
+    }
+    for (unsigned i = 0; i < sizeof(s_kiosk_assets) / sizeof(s_kiosk_assets[0]); i++) {
+        if (strcmp(req->uri, s_kiosk_assets[i].uri) == 0) {
+            httpd_resp_set_type(req, s_kiosk_assets[i].type);
+            return httpd_resp_send(req, (const char *)s_kiosk_assets[i].start,
+                                   s_kiosk_assets[i].end - s_kiosk_assets[i].start);
+        }
+    }
+    httpd_resp_set_status(req, "404 Not Found");
+    httpd_resp_sendstr(req, "kiosk asset not found");
+    return ESP_OK;
+}
+
 static void cors(httpd_req_t *req)
 {
     httpd_resp_set_hdr(req, "Access-Control-Allow-Origin", "*");
